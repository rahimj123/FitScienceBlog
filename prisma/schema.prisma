generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  role         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  profile      Profile?
  physicianReviews PhysicianReview[] @relation("PhysicianReviewer")
  auditLogs    AuditLog[]
  chatSessions ChatSession[]
  followUpTasks FollowUpTask[]
  userMemberships UserMembership[]
  upgradeHistory UpgradeHistory[]
  engagementMetrics EngagementMetric[]
}

model Profile {
  id                   String      @id @default(cuid())
  userId               String      @unique
  firstName            String
  lastName             String
  dateOfBirth          DateTime
  gender               String
  phone                String
  emergencyContactName String
  emergencyContactPhone String
  disabilityFlag       Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  intakeForms          IntakeForm[]
  pathways             Pathway[]
  flags                Flag[]
  clientCategories     ClientCategory[]
  physicianReviews     PhysicianReview[] @relation("ClientPhysicianReview")
  chatbotSessions      ChatSession[]
  followUpTasks        FollowUpTask[]
  userMemberships      UserMembership[]
  providerConnections  ProviderClientConnection[]
  biomarkerResults     UserBiomarkerResult[]
  labTests             LabTest[]
  userProtocols        UserProtocol[]
}

model IntakeForm {
  id                    String            @id @default(cuid())
  profileId             String
  servicePreference     String
  preferredPathway      String
  status                String
  submittedAt           DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  onboardingVersion     String            @default("v1")
  screeningStage1       ScreeningStage1?
  screeningStage2       ScreeningStage2?
  wellnessHistory       WellnessHistory?
  consent               Consent?
  profile               Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ScreeningStage1 {
  id                         String   @id @default(cuid())
  intakeFormId               String   @unique
  heartCondition             Boolean  @default(false)
  chestDiscomfort            Boolean  @default(false)
  dizzinessOrFainting        Boolean  @default(false)
  breathingIssues            Boolean  @default(false)
  diabetesManagementConcern  Boolean  @default(false)
  musculoskeletalLimitation  Boolean  @default(false)
  currentActivityLevel       String
  lightActivityMinutes       Int      @default(0)
  moderateActivityMinutes    Int      @default(0)
  vigorousActivityMinutes    Int      @default(0)
  weeklyActivityMinutes      Int
  notes                      String?
  intakeForm                 IntakeForm @relation(fields: [intakeFormId], references: [id], onDelete: Cascade)
}

model ScreeningStage2 {
  id                       String   @id @default(cuid())
  intakeFormId             String   @unique
  ageRisk                  Boolean  @default(false)
  smokingHistory           Boolean  @default(false)
  bloodPressureHistory     Boolean  @default(false)
  cholesterolHistory       Boolean  @default(false)
  bloodGlucoseHistory      Boolean  @default(false)
  medicationConsiderations Boolean  @default(false)
  priorHospitalizations    Boolean  @default(false)
  pregnancyRelated         Boolean  @default(false)
  injuryHistory            Boolean  @default(false)
  details                  String?
  intakeForm               IntakeForm @relation(fields: [intakeFormId], references: [id], onDelete: Cascade)
}

model WellnessHistory {
  id                    String   @id @default(cuid())
  intakeFormId          String   @unique
  sleepQuality          String
  stressLoad            String
  nutritionPattern      String
  movementHistory       String
  mentalWellbeing       String
  primaryGoals          String
  currentBarriers       String
  advancedInterest      Boolean  @default(false)
  intakeForm            IntakeForm @relation(fields: [intakeFormId], references: [id], onDelete: Cascade)
}

model Consent {
  id                         String   @id @default(cuid())
  intakeFormId               String   @unique
  coachingConsent            Boolean
  privacyConsent             Boolean
  physicianConsultConsent    Boolean
  liabilityAcknowledgement   Boolean
  signature                  String
  signedAt                   DateTime @default(now())
  intakeForm                 IntakeForm @relation(fields: [intakeFormId], references: [id], onDelete: Cascade)
}

model Pathway {
  id                String   @id @default(cuid())
  profileId         String
  pathwayType       String
  currentStatus     String
  requiresClearance Boolean  @default(false)
  assignedBy        String   @default("system")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Flag {
  id          String   @id @default(cuid())
  profileId   String
  flagType    String
  severity    String
  source      String
  description String
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Category {
  id          String           @id @default(cuid())
  slug        String           @unique
  label       String
  description String?
  clients     ClientCategory[]
}

model ClientCategory {
  id         String   @id @default(cuid())
  profileId   String
  categoryId  String
  assignedAt  DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, categoryId])
}

model PhysicianReview {
  id                   String   @id @default(cuid())
  profileId            String
  physicianUserId      String?
  consultationBookedAt DateTime?
  consultationStatus   String
  reviewSummary        String?
  clearanceDecision    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  profile              Profile  @relation("ClientPhysicianReview", fields: [profileId], references: [id], onDelete: Cascade)
  physicianUser        User?    @relation("PhysicianReviewer", fields: [physicianUserId], references: [id])
  labRecommendations   LabRecommendation[]
}

model LabRecommendation {
  id                 String   @id @default(cuid())
  physicianReviewId  String
  title              String
  rationale          String
  status             String
  createdAt          DateTime @default(now())
  physicianReview    PhysicianReview @relation(fields: [physicianReviewId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model FollowUpTask {
  id             String   @id @default(cuid())
  profileId       String
  assignedUserId  String?
  taskType        String
  status          String
  note            String
  dueAt           DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedUser    User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
}

model ChatSession {
  id                 String   @id @default(cuid())
  userId             String?
  profileId          String?
  mode               String
  status             String
  completionStatus   String   @default("in_progress")
  currentStep        String
  progressPercent    Int      @default(0)
  pathwayInterest    String?
  recommendedPathway String?
  routingReason      String?
  email              String?
  draftJson          Json?
  transcriptJson     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile            Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  messages           ChatbotMessage[]
  fragments          IntakeResponseFragment[]
}

model ChatbotMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String
  content    String
  createdAt  DateTime @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model IntakeResponseFragment {
  id               String   @id @default(cuid())
  sessionId        String
  fieldKey         String
  valueJson        Json?
  responseSource   String
  completionStatus String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  session          ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id                   String   @id @default(cuid())
  tier                 String   @unique
  name                 String
  purpose              String
  stageFocus           Json
  socialInterventions  Json
  coreFeatures         Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  memberships          Membership[]
}

model Membership {
  id                   String   @id @default(cuid())
  tier                 String   @unique
  lifecycleRole        String
  socialDriver         String
  upgradeTarget        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  membershipPlanId     String
  membershipPlan       MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  userMemberships      UserMembership[]
}

model UserMembership {
  id                   String   @id @default(cuid())
  userId               String
  profileId            String?
  membershipId         String
  subscriptionStatus   String
  currentTier          String
  recommendedTier      String
  stageOfChange        String
  engagementScore      Int      @default(0)
  startedAt            DateTime @default(now())
  renewedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile              Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  membership           Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  upgradeHistory       UpgradeHistory[]
  engagementMetrics    EngagementMetric[]
}

model UpgradeHistory {
  id                   String   @id @default(cuid())
  userMembershipId     String
  userId               String
  fromTier             String?
  toTier               String
  changedBy            String   @default("system")
  reason               String
  changedAt            DateTime @default(now())
  userMembership       UserMembership @relation(fields: [userMembershipId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EngagementMetric {
  id                   String   @id @default(cuid())
  userMembershipId     String
  userId               String
  socialTouchpoints    Int      @default(0)
  accountabilityTouches Int     @default(0)
  milestoneCount       Int      @default(0)
  engagementScore      Int      @default(0)
  recommendedTier      String
  recordedAt           DateTime @default(now())
  userMembership       UserMembership @relation(fields: [userMembershipId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CorporateLead {
  id                   String   @id @default(cuid())
  organizationName     String
  contactName          String
  contactEmail         String
  teamSize             String
  priorities           String
  interestArea         String
  status               String   @default("new")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ── Wellness & Health Dashboard Models ─────────────────────────────────────

model WellnessProvider {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  providerType      String   // "physician" | "trainer" | "nutritionist" | "wellness_doctor"
  specialization    String?
  credentials       String[]
  bio               String?
  profileImageUrl   String?
  email             String?  @unique
  phone             String?
  locationCity      String?
  locationCountry   String?
  isVerified        Boolean  @default(false)
  isAcceptingClients Boolean @default(true)
  availabilityNote  String?
  linkedinUrl       String?
  websiteUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  clientConnections ProviderClientConnection[]
  protocols         HealthProtocol[]
}

model ProviderClientConnection {
  id            String   @id @default(cuid())
  profileId     String
  providerId    String
  status        String   @default("pending") // "pending" | "active" | "paused" | "ended"
  requestNote   String?
  acceptedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider      WellnessProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([profileId, providerId])
}

model BiomarkerCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  icon        String?
  colorHex    String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  biomarkers  Biomarker[]
}

model Biomarker {
  id                  String   @id @default(cuid())
  categoryId          String
  name                String
  slug                String   @unique
  unit                String
  description         String?
  whyItMatters        String?
  whatAffectsIt       String?
  referenceRangeLow   Float?
  referenceRangeHigh  Float?
  optimalRangeLow     Float?
  optimalRangeHigh    Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  category            BiomarkerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  results             UserBiomarkerResult[]
}

model UserBiomarkerResult {
  id            String   @id @default(cuid())
  profileId     String
  biomarkerId   String
  labTestId     String?
  value         Float
  status        String   // "in_range" | "low" | "high" | "critical_low" | "critical_high"
  note          String?
  testedAt      DateTime
  createdAt     DateTime @default(now())
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  biomarker     Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)
  labTest       LabTest?  @relation(fields: [labTestId], references: [id], onDelete: SetNull)
}

model LabTest {
  id              String   @id @default(cuid())
  profileId       String
  testType        String   // "annual" | "follow_up" | "on_demand"
  testName        String
  status          String   @default("scheduled") // "scheduled" | "sample_collected" | "processing" | "completed"
  scheduledAt     DateTime?
  completedAt     DateTime?
  notes           String?
  recommendedBy   String?  // provider id or "system"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  biomarkerResults UserBiomarkerResult[]
}

model HealthProtocol {
  id              String   @id @default(cuid())
  providerId      String?
  title           String
  protocolType    String   // "nutrition" | "supplement" | "exercise" | "sleep" | "whole_body"
  goal            String?
  durationWeeks   Int?
  description     String
  steps           Json     // array of step objects { order, instruction, frequency }
  tags            String[]
  isTemplate      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  provider        WellnessProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  userProtocols   UserProtocol[]
}

model UserProtocol {
  id              String   @id @default(cuid())
  profileId       String
  protocolId      String
  assignedBy      String?  // userId of assigner
  status          String   @default("active") // "active" | "paused" | "completed"
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  adherenceScore  Int?     // 0-100
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  protocol        HealthProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
}
