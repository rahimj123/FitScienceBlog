# ─────────────────────────────────────────────────────────────────────────────
# .env.docker  —  Environment variables for Docker Compose
#
# This file is safe to commit for local development.
# For production, replace all values and keep this file secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PGUSER=fitscience
PGPASSWORD=fitscience_secret
PGDATABASE=fitscience
PGHOST=db
PGPORT=5432

# Prisma connection strings (host = Docker service name "db")
DATABASE_URL=postgresql://fitscience:fitscience_secret@db:5432/fitscience
DIRECT_URL=postgresql://fitscience:fitscience_secret@db:5432/fitscience

# ── App ───────────────────────────────────────────────────────────────────────
SESSION_SECRET=wellness-docker-local-session-secret-change-in-production
NODE_ENV=development

# ── Optional features (leave blank to disable) ────────────────────────────────
GITHUB_MEDIA_MIRROR_ENABLED=false
GITHUB_MEDIA_MIRROR_REQUIRED=false
GITHUB_MEDIA_REPO_OWNER=
GITHUB_MEDIA_REPO_NAME=
GITHUB_MEDIA_REPO_BRANCH=main
GITHUB_MEDIA_REPO_BASE_PATH=media-assets
GITHUB_MEDIA_REPO_TOKEN=

# Google Analytics / Ads (optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_ADSENSE_ID=
VITE_AMAZON_AFFILIATE_ID=
