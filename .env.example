# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
DIRECT_URL=postgresql://user:password@host:port/database

# Session Configuration
SESSION_SECRET=replace-with-a-long-random-secret

# Optional GitHub media mirror
GITHUB_MEDIA_MIRROR_ENABLED=false
GITHUB_MEDIA_MIRROR_REQUIRED=false
GITHUB_MEDIA_REPO_OWNER=
GITHUB_MEDIA_REPO_NAME=
GITHUB_MEDIA_REPO_BRANCH=main
GITHUB_MEDIA_REPO_BASE_PATH=media-assets
GITHUB_MEDIA_REPO_TOKEN=

# Google Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=

# Advertising IDs (Optional)
VITE_GOOGLE_ADSENSE_ID=
VITE_AMAZON_AFFILIATE_ID=

# API Keys for Third-party Services (Optional)
# Add any additional API keys your application might need
